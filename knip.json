{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignore": ["dist/**"],
	"ignoreDependencies": [
		"@arethetypeswrong/cli",
		"prettier",
		"publint",
		"sherif"
	],
	"workspaces": {
		"internals/eslint-config": {
			"project": ["source/**/*.ts"]
		},
		"internals/scripts": {
			"entry": ["source/*.mts"],
			"project": ["source/**/*.mts"]
		},
		"packages/actions": {
			"entry": ["scripts/*.ts"],
			"ignore": ["**/*.test.ts"],
			"project": ["source/**/*.ts"]
		},
		"packages/items": {
			"ignore": ["**/*.test.ts"],
			"project": ["source/**/*.ts"]
		},
		"packages/schemas": {
			"entry": ["scripts/*.ts"],
			"ignore": ["**/*.test.ts"],
			"project": ["source/**/*.ts"]
		}
	}
}
